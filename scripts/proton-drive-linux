#!/usr/bin/env python3
import sys
from pathlib import Path

here = Path(__file__).resolve()
for candidate in (here.parent.parent, here.parent.parent / "lib" / "proton-drive-linux"):
    if (candidate / "proton_drive_linux").is_dir():
        sys.path.insert(0, str(candidate))
        break

from proton_drive_linux.app import main

if __name__ == "__main__":
    raise SystemExit(main())
